LIMA_HOST=127.0.0.1
LIMA_PORT=8080
# Host port used by Docker Compose; container port remains 8080.
LIMA_HTTP_PORT=18080
LIMA_DB_PATH=lima.db
LIMA_MAX_DIFF_BYTES=1048576
LIMA_MAX_STEPS=8
LIMA_TIMEOUT_SECONDS=120

# Repository scan service. Only subdirectories below this host directory can be
# selected by API repository_key; the container mounts it read-only.
LIMA_REPOSITORY_IMPORT_PATH=./repositories
LIMA_REPOSITORY_SCAN_SAST_MODE=required
LIMA_REPOSITORY_SCAN_MAX_FILES=5000
LIMA_REPOSITORY_SCAN_MAX_FILE_BYTES=524288
LIMA_REPOSITORY_SCAN_MAX_TOTAL_BYTES=20971520
# Production semantic triage: off | auto | required. Enabling auto/required
# performs one bounded remote model request per repository scan when candidates exist.
LIMA_REPOSITORY_SCAN_LLM_MODE=auto
LIMA_REPOSITORY_SCAN_LLM_TIMEOUT_SECONDS=60
LIMA_REPOSITORY_SCAN_LLM_MAX_CANDIDATES=6
LIMA_REPOSITORY_SCAN_LLM_MAX_CONTEXT_CHARS=36000
LIMA_REPOSITORY_SCAN_LLM_MAX_COMPLETION_TOKENS=3000

# Durable repository-disjoint experiments. Artifacts are written under
# output/experiments and survive the initiating browser or ChatGPT session.
LIMA_EXPERIMENT_OUTPUT_PATH=./output/experiments
LIMA_EXPERIMENT_WORKERS=1
LIMA_EXPERIMENT_QUEUE_LEASE_SECONDS=3600
LIMA_EXPERIMENT_MAX_LLM_CALLS=20
LIMA_EXPERIMENT_MAX_TOTAL_TOKENS=100000

# Docker Compose infrastructure secret. Generate local values with:
#   powershell -ExecutionPolicy Bypass -File scripts/bootstrap_docker_env.ps1
LIMA_POSTGRES_PASSWORD=

# Login is disabled by default for local use. Enable it before exposing the service.
LIMA_AUTH_REQUIRED=false
LIMA_AUTH_SECRET=
LIMA_BOOTSTRAP_ADMIN_USERNAME=
LIMA_BOOTSTRAP_ADMIN_PASSWORD=
LIMA_DEFAULT_TENANT_ID=default
LIMA_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer and requires no remote API.
LIMA_LLM_PROVIDER=local

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
LIMA_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
LIMA_OPENROUTER_API_KEY=
LIMA_OPENROUTER_SITE_URL=
LIMA_OPENROUTER_APP_NAME=LIMA

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
LIMA_LLM_BASE_URL=
LIMA_LLM_API_KEY=
LIMA_LLM_MODEL=

# Replay evaluation and evolution activation gate
LIMA_EVAL_MAX_CASES=5
LIMA_EVAL_MIN_CASES=3
LIMA_EVAL_MIN_HOLDOUT_CASES=2
LIMA_EVAL_MIN_IMPROVEMENT=0.01
LIMA_EVAL_MAX_METRIC_REGRESSION=0

# GitHub integration
LIMA_GITHUB_WEBHOOK_SECRET=
LIMA_GITHUB_TOKEN=
LIMA_AUTO_POST_REVIEW=false
LIMA_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
LIMA_DATABASE_URL=
LIMA_REDIS_URL=
LIMA_ASYNC_WORKERS=2
LIMA_QUEUE_MAX_ATTEMPTS=3
LIMA_QUEUE_LEASE_SECONDS=60
LIMA_SKILLS_DIR=skills
LIMA_SKILL_SANDBOX=true
LIMA_SKILL_TIMEOUT_SECONDS=30
LIMA_SKILL_MEMORY_MB=256
LIMA_SKILL_SIGNING_KEY=

# Repair verification and observability. CWE-22/78/89 publication is blocked
# until this is set to the authorized target repository's regression test command.
LIMA_REPAIR_TEST_COMMAND=
LIMA_REPAIR_VERIFY_TIMEOUT_SECONDS=120
LIMA_AGENT_MAX_WORKERS=4
LIMA_AGENT_RETRIES=1
LIMA_COLLABORATION_ROUNDS=2
LIMA_AGENT_LOOP_MAX_STEPS=4
LIMA_AGENT_LOOP_TIMEOUT_SECONDS=45
LIMA_CONTEXT_MAX_TOKENS=12000
LIMA_CONTEXT_RESERVED_TOKENS=2500
LIMA_MEMORY_ENABLED=true
LIMA_MEMORY_RECALL_LIMIT=6
LIMA_MEMORY_WORKING_TTL_SECONDS=86400
LIMA_OTEL_ENDPOINT=
LIMA_OTEL_SERVICE_NAME=lima
LIMA_ALERT_FAILURE_RATE=0.20
LIMA_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
LIMA_GITHUB_APP_ID=
LIMA_GITHUB_APP_SLUG=
LIMA_GITHUB_PRIVATE_KEY_PATH=
LIMA_PUBLIC_BASE_URL=http://127.0.0.1:18080
