# Local Python acceptance profile. Load into process environment explicitly.
# Retain the administrator's authentication configuration; no credentials here.
LIMA_REPOSITORY_IMPORT_ROOT=D:\paper\油气数据\油气工业软件源码
LIMA_REPOSITORY_SCAN_SOURCES=local-import
LIMA_REPOSITORY_SCAN_MAX_FILES=20000
LIMA_REPOSITORY_SCAN_MAX_FILE_BYTES=8388608
LIMA_REPOSITORY_SCAN_MAX_TOTAL_BYTES=268435456
LIMA_REPOSITORY_SCAN_LLM_MODE=off
LIMA_REPOSITORY_INVESTIGATION_MODE=off
LIMA_CXX_AGENT_MODE=off
LIMA_CXX_MEMORY_MODE=auto
LIMA_CXX_ANALYZER_URL=http://127.0.0.1:18091
LIMA_CXX_ANALYSIS_TIMEOUT_SECONDS=700
# Apply the same three repository scan budgets to the Sidecar container.
# Mount only the selected repository at /repositories/ResInsight, read-only.
LIMA_CXX_AUTO_CMAKE=false
LIMA_CXX_TRUSTED_BUILD_CONTEXT_GENERATION=false
LIMA_CXX_STEP_TIMEOUT_SECONDS=180
LIMA_CXX_TOTAL_TIMEOUT_SECONDS=600
LIMA_CXX_MAX_OUTPUT_BYTES=4194304
